{
  "name": "@reliverse/gr-action-runtime",
  "version": "0.1.0",
  "private": false,
  "description": "Actor-neutral GR repository Action Plane adapter for bounded repository patch preview and application.",
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./repo": {
      "types": "./src/repo.ts",
      "import": "./src/repo.ts"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ./src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reliverse/auth": "workspace:*",
    "@reliverse/cap": "workspace:*",
    "@reliverse/gatehouse-protocol": "workspace:*",
    "@reliverse/gatehouse-runtime": "workspace:*",
    "@reliverse/gr": "workspace:*",
    "@reliverse/quality": "workspace:*",
    "@reliverse/repo-cap": "workspace:*",
    "@reliverse/workspace-runtime": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript-7": "catalog:"
  }
}

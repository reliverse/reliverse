{
  "name": "@reliverse/gr",
  "version": "0.1.0",
  "private": false,
  "description": "Typed Git-backed workspace inspection, snapshot, diff, patch, recovery, and restore contracts for Reliverse tooling.",
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ./src",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "dependencies": {
    "@reliverse/rpr-toolchain-materialization": "workspace:*",
    "@reliverse/rse-handoff": "workspace:*",
    "@reliverse/rvs-private": "workspace:*"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript-7": "catalog:"
  }
}

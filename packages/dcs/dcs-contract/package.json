{
  "name": "@reliverse/dcs-contract",
  "version": "0.1.0",
  "private": false,
  "description": "Portable DCS Config Contract Bundle, document validation, resolution, provenance, canonical JSON, and schema utilities.",
  "files": [
    "src",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test ./src",
    "typecheck": "tsc -p ./tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript-7": "catalog:"
  }
}
